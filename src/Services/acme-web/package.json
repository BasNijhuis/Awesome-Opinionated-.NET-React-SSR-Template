{
  "name": "acme-web",
  "private": true,
  "type": "module",
  "scripts": {
    "api:generate": "dotnet build ../Acme.Api/Acme.Api.csproj && openapi-ts && pnpm -C ../../.. --filter scripts run gen-api-types",
    "build": "pnpm run api:generate && react-router build",
    "dev": "react-router dev",
    "start": "node ./server.js",
    "typecheck": "pnpm run api:generate && react-router typegen && tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "pnpm run api:generate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@microsoft/signalr": "10.0.11",
    "@react-router/express": "8.3.1",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "compression": "1.8.2",
    "express": "5.2.1",
    "http-proxy-middleware": "4.2.0",
    "i18next": "26.4.2",
    "isbot": "5.2.2",
    "morgan": "1.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.14",
    "react-router": "8.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@hey-api/openapi-ts": "0.99.0",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
