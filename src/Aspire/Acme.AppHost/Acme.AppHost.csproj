<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>f76d6d52-ddb8-4c73-8f1f-90bd1f438043</UserSecretsId>
    <!-- Aspire 17 requires the Aspire CLI bundle for C# AppHosts (ASPIRE013, no opt-out). DnxPinned
         fetches it through `dnx aspire.cli@<this AppHost's Aspire version>` instead of whatever `aspire`
         is on PATH, so no global CLI install is needed and a stale one can't cause version skew. -->
    <AspireCliInvocationMode>DnxPinned</AspireCliInvocationMode>
  </PropertyGroup>

  <!-- A plain Microsoft.NET.Sdk AppHost: Aspire 17 deprecates Aspire.AppHost.Sdk (ASPIRE012). The API is
       registered by path with AddDotnetProject, so there is no ProjectReference to it. -->
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>
</Project>
