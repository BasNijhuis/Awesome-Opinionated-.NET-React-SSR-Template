<Project>
  <ItemGroup>
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />

    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />

    <!-- API client runtime (Kiota). The generator is the `kiota` local tool in
         .config/dotnet-tools.json; bump both together per `dotnet kiota info -l CSharp`. -->
    <PackageVersion Include="Microsoft.Kiota.Bundle" Version="2.2.0" />
    <!-- Transitive pin only (EF Core Design, Aspire): no project references it directly, but without
         this pin some projects resolve the older 13.0.3. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- Extensions -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.1" />

    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />

    <!-- Database -->
    <!-- The EF Core provider directly, not Aspire's client integration: the write contexts are
         registered with plain AddDbContext + UseNpgsql (ADR-0016), so nothing uses the integration's API,
         and its latest stable release (13.6.5) still pins EF Core 10. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
    <!-- Design tracks the EF Core major that Npgsql.EntityFrameworkCore.PostgreSQL brings, never ahead
         of it, or the *.Infrastructure assemblies compile against an EF Core the test projects don't
         resolve (CS1705). Move the two in lockstep. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <!-- Security pin (transitive only): Microsoft.CodeAnalysis.Analyzer.Testing 1.1.4 -> NuGet.Packaging
         7.0.3 brings 9.0.6, which has GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />

    <!-- Roslyn analyzers -->
    <!-- 5.12.0 is the compiler in SDK 11.0.100, the first with stable C# 15 union support
         (ITypeSymbol.IsUnion), which ACME002 needs; analyzers built against it need a 5.12+ compiler host.
         EF Core Design 11 pulls the 5.9.0 Roslyn set, whose packages require each other at exactly 5.9.0,
         so the rest of the set is pinned to 5.12.0 too (EF Design accepts >= 5.9.0); without these pins
         restore reports NU1608. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.12.0" />

    <!-- Testing -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>
</Project>
